{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/dev/plugin-framework-current/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "io.dbx.files",
  "name": "DBX Files",
  "version": "0.1.11",
  "publisher": "xynanan",
  "description": "Multi-backend storage workbench plugin for DBX, powered by Apache OpenDAL.",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.5.77",
    "host_api": ">=1.0.0"
  },
  "permissions": [
    "host.workbench",
    "host.events",
    "host.binary",
    "host.filesystem"
  ],
  "entrypoints": {
    "backend": {
      "transport": "stdio-framed",
      "executable": "bin/dbx-plugin-files"
    },
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    }
  },
  "contributions": [
    {
      "type": "connection-provider",
      "id": "io.dbx.files.connection",
      "label": "Storage",
      "icon": "assets/plugin.svg",
      "database_type": "storage",
      "description": "Storage connection through Apache OpenDAL: local filesystem, S3/MinIO, WebDAV, FTP, SFTP, or any compiled OpenDAL service.",
      "fields": [
        {
          "key": "display_name",
          "label": "Connection name",
          "type": "text",
          "binding": "name",
          "required": true,
          "default": "Storage"
        },
        {
          "key": "protocol",
          "label": "Protocol",
          "type": "select",
          "binding": "config",
          "required": true,
          "default": "fs",
          "options": [
            {
              "label": "Local filesystem",
              "value": "fs"
            },
            {
              "label": "S3 / MinIO",
              "value": "s3"
            },
            {
              "label": "WebDAV",
              "value": "webdav"
            },
            {
              "label": "FTP",
              "value": "ftp"
            },
            {
              "label": "SFTP",
              "value": "sftp"
            },
            {
              "label": "SFTP (native)",
              "value": "sftp-native"
            },
            {
              "label": "SMB / CIFS",
              "value": "smb"
            },
            {
              "label": "OpenDAL custom service",
              "value": "opendal-custom"
            }
          ]
        },
        {
          "key": "root",
          "label": "Root path",
          "type": "text",
          "binding": "config",
          "default": "",
          "description": "All operations are confined under this root when set."
        },
        {
          "key": "lock_to_root",
          "label": "Lock navigation to root",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "description": "Reject any path outside the configured root."
        },
        {
          "key": "service",
          "label": "OpenDAL service name",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "opendal-custom"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "opendal-custom"
            ]
          },
          "description": "Any compiled OpenDAL service, e.g. gcs, azblob, oss, memory."
        },
        {
          "key": "config",
          "label": "Service config (JSON)",
          "type": "textarea",
          "binding": "config",
          "default": "{}",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "opendal-custom"
            ]
          },
          "description": "JSON object passed verbatim as OpenDAL Builder key/values, e.g. {\"root\":\"/tmp\",\"bucket\":\"demo\"}."
        },
        {
          "key": "bucket",
          "label": "Bucket",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          }
        },
        {
          "key": "endpoint",
          "label": "Endpoint",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "s3",
              "webdav",
              "ftp",
              "sftp",
              "smb",
              "sftp-native"
            ]
          },
          "description": "S3/WebDAV/FTP: full URL, e.g. http://127.0.0.1:9000. SFTP/SFTP native: OpenSSH style user@host or ssh://user@host:port (native also accepts host:port with the user field). SMB: host[:445] or smb://host[:445], e.g. nas.local:445 or smb://nas.local."
        },
        {
          "key": "share",
          "label": "Share",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "smb"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "smb"
            ]
          },
          "description": "SMB share name used as the tree connect target."
        },
        {
          "key": "region",
          "label": "Region",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          }
        },
        {
          "key": "access_key_id",
          "label": "Access key ID",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          }
        },
        {
          "key": "secret_access_key",
          "label": "Secret access key",
          "type": "password",
          "binding": "secret",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          },
          "required_when": {
            "field": "protocol",
            "one_of": [
              "s3"
            ]
          }
        },
        {
          "key": "username",
          "label": "Username",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "webdav",
              "smb"
            ]
          }
        },
        {
          "key": "domain",
          "label": "Domain",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "smb"
            ]
          },
          "description": "NTLM domain or workgroup; leave empty when not needed."
        },
        {
          "key": "user",
          "label": "User",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "ftp"
            ]
          },
          "description": "Leave empty for anonymous login."
        },
        {
          "key": "password",
          "label": "Password",
          "type": "password",
          "binding": "secret",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "webdav",
              "ftp",
              "sftp",
              "smb",
              "sftp-native"
            ]
          },
          "description": "Used for password login on SFTP native (falls back to keyboard-interactive automatically); also the webdav/ftp/smb login password."
        },
        {
          "key": "key",
          "label": "Private key or path",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "sftp",
              "sftp-native"
            ]
          },
          "description": "Private key content or a path to the key file. SFTP native uses the key when the password is empty."
        },
        {
          "key": "known_hosts_strategy",
          "label": "Known hosts strategy",
          "type": "select",
          "binding": "config",
          "default": "Tolerate",
          "options": [
            {
              "label": "Tolerate",
              "value": "Tolerate"
            },
            {
              "label": "Strict",
              "value": "Strict"
            },
            {
              "label": "Trust",
              "value": "Trust"
            }
          ],
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "sftp",
              "sftp-native"
            ]
          }
        },
        {
          "key": "read_only",
          "label": "Read only",
          "type": "boolean",
          "binding": "config",
          "default": false,
          "description": "Reject every write operation on this connection."
        },
        {
          "key": "allow_delete",
          "label": "Allow delete",
          "type": "boolean",
          "binding": "config",
          "default": true,
          "description": "When off, delete/purge operations are rejected."
        },
        {
          "key": "connection_mode",
          "label": "Connection mode",
          "type": "select",
          "binding": "config",
          "default": "direct",
          "visible_when": {
            "field": "protocol",
            "one_of": [
              "sftp",
              "ftp"
            ]
          },
          "options": [
            {
              "label": "Direct",
              "value": "direct"
            },
            {
              "label": "Through DBX SSH tunnel",
              "value": "via-dbx-ssh"
            }
          ]
        },
        {
          "key": "dbx_ssh_connection",
          "label": "DBX SSH connection",
          "type": "text",
          "binding": "config",
          "default": "",
          "visible_when": {
            "field": "connection_mode",
            "one_of": [
              "via-dbx-ssh"
            ]
          },
          "required_when": {
            "field": "connection_mode",
            "one_of": [
              "via-dbx-ssh"
            ]
          },
          "description": "Host SSH connection id used to forward the tunnel."
        },
        {
          "key": "timeout_secs",
          "label": "Operation timeout (seconds)",
          "type": "number",
          "binding": "config",
          "default": 30
        }
      ],
      "workbench": "io.dbx.files.workbench",
      "capabilities": [
        "test",
        "connect",
        "disconnect"
      ]
    },
    {
      "type": "workbench",
      "id": "io.dbx.files.workbench",
      "label": "Files Workbench",
      "description": "Browse, transfer, and sync files across OpenDAL storage backends.",
      "icon": "assets/plugin.svg"
    }
  ],
